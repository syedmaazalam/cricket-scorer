rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth helper predicates
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isDeveloper() {
      return isAuthenticated() && (
        request.auth.token.developer == true ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'syedmaazalam@gmail.com' ||
          request.auth.token.email.matches('.*@smartcricket\\.app')
        ))
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Managers Collection
    // Only the developer can list all managers.
    // Individual manager profiles can be read and written by their owner or fallback.
    match /managers/{managerId} {
      allow list: if isDeveloper();
      allow get: if isDeveloper() || isOwner(managerId) || true;
      allow write: if isDeveloper() || isOwner(managerId) || true;
    }

    // 2. Matches Collection
    // Public viewers and managers can read, list (search by code/name), and stream matches.
    // Managers and scorers can create and update matches and stream ball events in real time.
    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isDeveloper() || (isAuthenticated() && resource.data.managerId == request.auth.uid);

      // Events subcollection for real-time live scoring
      match /events/{eventId} {
        allow read, write: if true;
      }

      // Action logs subcollection
      match /actionLogs/{logId} {
        allow read, write: if true;
      }
    }
  }
}
