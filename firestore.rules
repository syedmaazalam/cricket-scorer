rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth helper predicates
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isDeveloper() {
      return isAuthenticated() && (
        request.auth.token.developer == true ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'syedmaazalam@gmail.com' ||
          request.auth.token.email == 'syedmaazalam2007@gmail.com' ||
          request.auth.token.email.matches('.*@smartcricket\\.app')
        ))
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Managers Collection
    // Only developers can list all managers.
    // Individual manager documents can only be accessed or modified by their owner or a developer.
    match /managers/{managerId} {
      allow list: if isDeveloper();
      allow get: if isDeveloper() || isOwner(managerId);
      allow write: if isDeveloper() || isOwner(managerId);
    }

    // 2. Mail Collection (Secure Email Verification & Alert Relay)
    // Prevents arbitrary open spam relay:
    // Requires authenticated user or strict structural validation (single valid recipient and SmartCricket subject).
    // Reading or manipulating mail queue documents is restricted to developers.
    match /mail/{mailId} {
      allow create: if isAuthenticated() || (
        request.resource.data.keys().hasAll(['to', 'message', 'createdAt']) &&
        request.resource.data.to is list &&
        request.resource.data.to.size() == 1 &&
        request.resource.data.to[0] is string &&
        request.resource.data.to[0].matches('.+@.+\\..+') &&
        request.resource.data.message.keys().hasAll(['subject', 'text', 'html']) &&
        request.resource.data.message.subject.matches('SmartCricket .*')
      );
      allow read, update, delete: if isDeveloper();
    }

    // 3. System Config & Releases
    // Read-only for public clients (app version checks); writeable only by developers.
    match /config/{configId} {
      allow read: if true;
      allow write: if isDeveloper();
    }

    // 4. Matches Collection & Real-Time Scoring
    // Public viewers can read and stream matches without authentication (read-only for spectators).
    // Scorers and managers must be authenticated (anonymously or via account) to create and score matches.
    // Match document is writable only by the match owner.
    match /matches/{matchId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isDeveloper() ||
        resource.data.ownerUid == request.auth.uid ||
        !('ownerUid' in resource.data) ||
        resource.data.ownerUid == null ||
        (
          request.resource.data.ownerUid == request.auth.uid &&
          ('leaseExpiresAt' in resource.data) &&
          request.time.toMillis() > resource.data.leaseExpiresAt
        )
      );
      allow delete: if isDeveloper() || (isAuthenticated() && (resource.data.managerId == request.auth.uid || resource.data.ownerUid == request.auth.uid));

      // Events subcollection for real-time live scoring (Phase 2 Requirement 3)
      // create only (no update or delete); doc ID must equal ${matchId}_${seq}; request.auth.uid == match.ownerUid
      match /events/{eventId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
          request.resource.data.seq is int &&
          eventId == matchId + '_' + string(request.resource.data.seq) &&
          (
            isDeveloper() ||
            !exists(/databases/$(database)/documents/matches/$(matchId)) ||
            get(/databases/$(database)/documents/matches/$(matchId)).data.ownerUid == request.auth.uid ||
            !('ownerUid' in get(/databases/$(database)/documents/matches/$(matchId)).data) ||
            get(/databases/$(database)/documents/matches/$(matchId)).data.ownerUid == null
          );
        allow update, delete: if false;
      }

      // Action logs subcollection
      match /actionLogs/{logId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      // Chat and developer-scorer messages subcollection
      match /messages/{messageId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }
  }
}
